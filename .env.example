APP_NAME=Backend API
DEMO_PASSWORD=replace-with-a-local-demo-password-of-12-chars
DATABASE_URL=sqlite:///./var/backend.sqlite3
AUTH_SESSION_TTL_SECONDS=604800
AUTH_CSRF_CHALLENGE_TTL_SECONDS=600
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_COOKIE_SECURE=false
# Generate a 32-byte key and store its base64 encoding in your secret manager.
MASTER_ENCRYPTION_KEY=
MASTER_ENCRYPTION_KEY_VERSION=1
SOS_SIGNING_KEY=
SOS_LINK_TTL_SECONDS=3600
SOS_PUBLIC_RATE_LIMIT_PER_MINUTE=30
PUBLIC_BASE_URL=http://127.0.0.1:8000
NOTIFICATION_LOG_PATH=var/notifications.log
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=
# Optional model adapter. Defaults to offline rule-based answers.
CHAT_MODEL_URL=
CHAT_MODEL_API_KEY=
ATTACHMENT_STORAGE_PATH=var/attachments
ATTACHMENT_MAX_SIZE_BYTES=10485760
# Rotation command inputs, provided securely in the environment when rotating:
OLD_MASTER_ENCRYPTION_KEY=
NEW_MASTER_ENCRYPTION_KEY=
NEW_MASTER_ENCRYPTION_KEY_VERSION=
